# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# Consumed by the LiteLLM-based ModelClient (closed models) + HF model pulls.

# Closed models (inference-only eval + grounded-judge reference pi_ref)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Hugging Face (gated Gemma weights + SWE-bench-PRO dataset)
HF_TOKEN=

# Open-model serving endpoint (Step 1 vLLM / Step 2 slime SGLang), OpenAI-compatible
# HRL_BASE_URL=http://localhost:8000/v1
